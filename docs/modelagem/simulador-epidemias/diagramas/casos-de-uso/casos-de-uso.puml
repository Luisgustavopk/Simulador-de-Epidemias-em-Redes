@startuml
left to right direction
skinparam monochrome true
skinparam dpi 170
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 80
skinparam ArrowFontSize 12
skinparam defaultFontName Arial
skinparam backgroundColor white
skinparam usecaseBackgroundColor #F1F1F1
skinparam usecaseBorderColor #555555
actor "Usuário acadêmico" as Usuario
rectangle "Simulador de Epidemias em Redes" {
  usecase "Selecionar rede observada\nou gerar rede sintética" as Rede
  usecase "Configurar modo de peso\ne parâmetros SIR" as Modelo
  usecase "Definir condições iniciais,\nlimite e sementes" as Inicial
  usecase "Configurar estratégia, mecanismo,\norçamento e início do isolamento" as Isolamento
  usecase "Executar simulação" as Executar
  usecase "Comparar cenários\ncom repetições" as Comparar
  usecase "Validar configuração" as Validar
  usecase "Consultar curvas, métricas\ne motivo do término" as Resultados
}
Usuario -- Rede
Usuario -- Modelo
Usuario -- Inicial
Usuario -- Isolamento
Usuario -- Executar
Usuario -- Comparar
Usuario -- Resultados
Executar ..> Validar : <<include>>
Comparar ..> Validar : <<include>>
@enduml
